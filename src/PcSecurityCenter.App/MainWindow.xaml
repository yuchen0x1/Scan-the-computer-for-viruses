<Window x:Class="PcSecurityCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 智能安全卫士" Height="820" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ===== 顶栏 ===== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushOverlay}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BrushGlowAccent}">
                        <Path Data="M15,2 A13,13 0 1,0 15,28 A13,13 0 0,0 15,2 M15,7 L15,15 L21,18"
                              Stroke="White" StrokeThickness="2" Fill="Transparent" Stretch="Uniform"
                              Margin="5" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows 智能安全卫士" FontSize="13.5" FontWeight="Bold" />
                        <TextBlock Text="PC Security Center" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 窗口控制（最小化/最大化/关闭）：置于顶栏最右，标准 Windows 布局 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch"
                            Margin="0,0,4,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" ToolTip="最小化"
                            Click="MinimizeButton_Click">
                        <Path Data="M0,6 H12" Stretch="Uniform" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="最大化 / 还原"
                            Click="MaximizeButton_Click">
                        <Path x:Name="MaximizeIcon" Data="M1,1 H11 V11 H1 Z" Stretch="Uniform" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" ToolTip="关闭"
                            Click="CloseButton_Click">
                        <Path Data="M1,1 L11,11 M11,1 L1,11" Stretch="Uniform" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" />
                    </Button>
                </StackPanel>

                <!-- 全局安全状态 -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource BrushStatusPillBg}" CornerRadius="999" Padding="12,5"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{Binding GlobalStatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GlobalStatusText}" FontSize="12" Margin="7,0,0,0"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>
                </Border>

                <!-- 通知中心 -->
                <Button x:Name="BellButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                        Padding="9,6" VerticalAlignment="Center" Margin="0,0,8,0" Click="BellButton_Click">
                    <Grid>
                        <Path Data="M12,2 A6,6 0 0,0 6,8 L6,13 L4,16 L20,16 L18,13 L18,8 A6,6 0 0,0 12,2 M10,19 A2.2,2.2 0 0,0 14,19"
                              Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.6" Fill="Transparent"
                              Stretch="Uniform" Width="16" />
                        <Ellipse x:Name="BellDot" Width="8" Height="8" Fill="{DynamicResource BrushDanger}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- 设置入口 -->
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,6"
                        VerticalAlignment="Center" Margin="0,0,8,0" Click="SettingsButton_Click">
                    <Path Data="M12,8.5 A3.5,3.5 0 1,0 12,15.5 A3.5,3.5 0 0,0 12,8.5 M12,2.5 L13.2,5.4 L16.2,4.4 L16.6,7.6 L19.6,8.6 L17.8,11 L19.8,13.4 L16.8,14.6 L17,17.8 L13.9,17.2 L12,20 L10.1,17.2 L7,17.8 L7.2,14.6 L4.2,13.4 L6.2,11 L4.4,8.6 L7.4,7.6 L7.8,4.4 L10.8,5.4 Z"
                          Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Fill="Transparent"
                          Stretch="Uniform" Width="16" />
                </Button>
                <!-- 填充器：防止 LastChildFill 吞掉最后一个 Dock=Right 元素 -->
                <Border />
            </DockPanel>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{DynamicResource BrushNavBg}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,10">
                    <StackPanel x:Name="NavGroup">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" Margin="0,0,10,0" Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock Text="安全驾驶舱" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavScan" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✚" Margin="0,0,10,0" Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock Text="病毒查杀" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavProtection" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡" Margin="0,0,10,0" FontSize="12" />
                                <TextBlock Text="实时防护" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavNetwork" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇆" Margin="0,0,10,0" Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock Text="网络安全" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSystemSecurity" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Margin="0,0,10,0" Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock Text="系统安全" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPerformance" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▁▄█" Margin="0,0,10,0" FontSize="10" />
                                <TextBlock Text="性能监控" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMaintenance" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳" Margin="0,0,10,0" Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock Text="系统维护" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavStartup" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,10,0" FontSize="11" />
                                <TextBlock Text="启动项管理" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSoftware" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" Margin="0,0,10,0" Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock Text="软件管理" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Margin="0,0,10,0" FontSize="12" />
                                <TextBlock Text="高级工具" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavFileAnalysis" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Margin="0,0,10,0" FontSize="11" />
                                <TextBlock Text="文件分析" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❐" Margin="0,0,10,0" Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock Text="安全报告" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✧" Margin="0,0,10,0" Foreground="{DynamicResource BrushAccent}" />
                                <TextBlock Text="设置中心" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUpdate" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳" Margin="0,0,10,0" FontSize="12" />
                                <TextBlock Text="更新中心" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Column="1">
                <ContentControl x:Name="ContentHost" Margin="18,14,18,6" />
            </Grid>

            <!-- 更新横幅：检测到并下载好新版本后浮现；倒计时结束自动重启更新，可「稍后」延后 -->
            <Border x:Name="UpdateBanner" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                    Margin="18,14,18,0" Panel.ZIndex="90" Visibility="Collapsed"
                    Style="{StaticResource SectionCard}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 0,0 12,2 M12,7 V12 L16,14"
                          Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.8" Fill="Transparent"
                          Stretch="Uniform" Width="22" Height="22" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateBannerTitle" FontWeight="Bold" FontSize="13" />
                        <TextBlock x:Name="UpdateBannerSub" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UpdateNowButton" Content="立即更新" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" Click="UpdateNowButton_Click" />
                        <Button x:Name="UpdateLaterButton" Content="稍后" Style="{StaticResource GhostButton}"
                                Click="UpdateLaterButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底栏 ===== -->
        <Border Grid.Row="2" Background="{DynamicResource BrushOverlay}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="VersionText" Text="v1.1.0" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                           VerticalAlignment="Center" Margin="16,0" />
                <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource BrushDivider}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding EngineStatusText}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                           VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource BrushDivider}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ElevationHint}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                           VerticalAlignment="Center" Margin="12,0" />
                <!-- 窗口控制按钮已移至顶栏最右，底栏不再放置 -->
                <Border DockPanel.Dock="Right" Width="8" />
            </DockPanel>
        </Border>

        <!-- Toast 通知容器 -->
        <Border x:Name="ToastHost" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,14,0" MaxWidth="380" Visibility="Collapsed" Panel.ZIndex="100">
            <Border x:Name="ToastCard" Style="{StaticResource SectionCard}" Margin="0">
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontWeight="Bold" FontSize="13" />
                    <TextBlock x:Name="ToastMessage" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 通知中心面板 -->
        <Border x:Name="NotificationCenter" Grid.Row="1" Grid.Column="1" Width="360" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,10,10,0" MaxHeight="520"
                Visibility="Collapsed" Panel.ZIndex="99">
            <Border Style="{StaticResource SectionCard}" Margin="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="通知中心" FontWeight="Bold" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource SmallGhostButton}"
                                Content="关闭" Click="CloseNotifications_Click" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NotificationList" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- 模态对话框宿主 -->
        <Border x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource BrushDialogOverlay}" Visibility="Collapsed"
                Panel.ZIndex="200">
            <Border x:Name="DialogCard" Style="{StaticResource SectionCard}" Width="440" Padding="24"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="16" FontWeight="Bold" />
                    <TextBlock x:Name="DialogMessage" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBox x:Name="DialogInput" Margin="0,12,0,0" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="DialogCancel" Style="{StaticResource GhostButton}" Content="取消"
                                Margin="0,0,10,0" Click="DialogCancel_Click" />
                        <Button x:Name="DialogOk" Style="{StaticResource PrimaryButton}" Content="确认"
                                Click="DialogOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
