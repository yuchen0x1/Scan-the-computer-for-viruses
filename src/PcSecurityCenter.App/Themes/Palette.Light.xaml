<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 亮色（白天模式）调色板 ===== -->
    <Color x:Key="ColorBgDeep">#F0F4F5</Color>
    <Color x:Key="ColorBgMid">#F6F9F9</Color>
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorCardLight">#F4F7FB</Color>
    <Color x:Key="ColorBorder">#D8E1E4</Color>
    <Color x:Key="ColorBorderLight">#BBCBD0</Color>
    <Color x:Key="ColorTextPrimary">#172B38</Color>
    <Color x:Key="ColorTextSecondary">#51636F</Color>
    <Color x:Key="ColorTextMuted">#697B87</Color>
    <Color x:Key="ColorAccent">#087F75</Color>
    <Color x:Key="ColorAccentBlue">#2F6DB2</Color>
    <Color x:Key="ColorOk">#17845D</Color>
    <Color x:Key="ColorWarn">#965A00</Color>
    <Color x:Key="ColorDanger">#B42318</Color>
    <Color x:Key="ColorPurple">#7C3AED</Color>

    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}" />
    <SolidColorBrush x:Key="BrushBgMid" Color="{StaticResource ColorBgMid}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardLight" Color="{StaticResource ColorCardLight}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource ColorAccentBlue}" />
    <SolidColorBrush x:Key="BrushOk" Color="{StaticResource ColorOk}" />
    <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource ColorWarn}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushPurple" Color="{StaticResource ColorPurple}" />

    <SolidColorBrush x:Key="BrushCardSolid" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BrushCardSoft" Color="#FFF3F7F7" />
    <SolidColorBrush x:Key="BrushCardHover" Color="#FFE8F0F1" />
    <SolidColorBrush x:Key="BrushNavHover" Color="#FFE7EEEE" />
    <SolidColorBrush x:Key="BrushInputBg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BrushPopupBg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BrushTooltipBg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BrushScrollThumb" Color="#FFBBCBD0" />
    <SolidColorBrush x:Key="BrushGridLine" Color="#FFE4EAF1" />
    <SolidColorBrush x:Key="BrushGridHeaderBorder" Color="#FFD8E0EA" />
    <SolidColorBrush x:Key="BrushRowAlt" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="BrushOverlay" Color="#FFF2F6FB" />
    <SolidColorBrush x:Key="BrushNavBg" Color="#FFF5F8F8" />
    <SolidColorBrush x:Key="BrushStatusPillBg" Color="#FFEFF3F9" />
    <SolidColorBrush x:Key="BrushDivider" Color="#FFE4EAF1" />
    <SolidColorBrush x:Key="BrushGridHeaderBg" Color="#FFEFF3F9" />
    <SolidColorBrush x:Key="BrushDangerBorder" Color="#88DC2626" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#1A0E7490" />
    <SolidColorBrush x:Key="BrushAccentMedium" Color="#332568EB" />
    <SolidColorBrush x:Key="BrushDialogOverlay" Color="#66000000" />
    <SolidColorBrush x:Key="BrushTrack" Color="#FFE2E8F0" />

    <SolidColorBrush x:Key="BrushWindowBg" Color="#FFF0F4F5" />
    <SolidColorBrush x:Key="BrushNavSelected" Color="#FFE1F0EE" />
    <SolidColorBrush x:Key="BrushPrimaryButton" Color="#FF087F75" />
    <SolidColorBrush x:Key="BrushGlowAccent" Color="#FF087F75" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="#243746" />
    <DropShadowEffect x:Key="AccentShadow" BlurRadius="8" ShadowDepth="0" Opacity="0.12" Color="#087F75" />
    <DropShadowEffect x:Key="DangerShadow" BlurRadius="8" ShadowDepth="0" Opacity="0.12" Color="#B42318" />

</ResourceDictionary>
