<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 暗色（夜间模式）调色板 ===== -->
    <Color x:Key="ColorBgDeep">#101821</Color>
    <Color x:Key="ColorBgMid">#141F29</Color>
    <Color x:Key="ColorCard">#19252F</Color>
    <Color x:Key="ColorCardLight">#202E38</Color>
    <Color x:Key="ColorBorder">#2C3B45</Color>
    <Color x:Key="ColorBorderLight">#3C4D57</Color>
    <Color x:Key="ColorTextPrimary">#E7EEF2</Color>
    <Color x:Key="ColorTextSecondary">#B2C0C8</Color>
    <Color x:Key="ColorTextMuted">#8697A2</Color>
    <Color x:Key="ColorAccent">#53C6B5</Color>
    <Color x:Key="ColorAccentBlue">#66A9F5</Color>
    <Color x:Key="ColorOk">#48B789</Color>
    <Color x:Key="ColorWarn">#F1B25B</Color>
    <Color x:Key="ColorDanger">#F27B78</Color>
    <Color x:Key="ColorPurple">#A78BFA</Color>

    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}" />
    <SolidColorBrush x:Key="BrushBgMid" Color="{StaticResource ColorBgMid}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardLight" Color="{StaticResource ColorCardLight}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource ColorAccentBlue}" />
    <SolidColorBrush x:Key="BrushOk" Color="{StaticResource ColorOk}" />
    <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource ColorWarn}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushPurple" Color="{StaticResource ColorPurple}" />

    <SolidColorBrush x:Key="BrushCardSolid" Color="#FF19252F" />
    <SolidColorBrush x:Key="BrushCardSoft" Color="#FF202E38" />
    <SolidColorBrush x:Key="BrushCardHover" Color="#FF293943" />
    <SolidColorBrush x:Key="BrushNavHover" Color="#332C3B45" />
    <SolidColorBrush x:Key="BrushInputBg" Color="#FF141F29" />
    <SolidColorBrush x:Key="BrushPopupBg" Color="#FF19252F" />
    <SolidColorBrush x:Key="BrushTooltipBg" Color="#FF202E38" />
    <SolidColorBrush x:Key="BrushScrollThumb" Color="#FF3C4D57" />
    <SolidColorBrush x:Key="BrushGridLine" Color="#332C3B45" />
    <SolidColorBrush x:Key="BrushGridHeaderBorder" Color="#442C3B45" />
    <SolidColorBrush x:Key="BrushRowAlt" Color="#FF1C2933" />
    <SolidColorBrush x:Key="BrushOverlay" Color="#FF121C25" />
    <SolidColorBrush x:Key="BrushNavBg" Color="#FF121C25" />
    <SolidColorBrush x:Key="BrushStatusPillBg" Color="#FF202E38" />
    <SolidColorBrush x:Key="BrushDivider" Color="#332C3B45" />
    <SolidColorBrush x:Key="BrushGridHeaderBg" Color="#FF202E38" />
    <SolidColorBrush x:Key="BrushDangerBorder" Color="#88F27B78" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#2253C6B5" />
    <SolidColorBrush x:Key="BrushAccentMedium" Color="#3353C6B5" />
    <SolidColorBrush x:Key="BrushDialogOverlay" Color="#88040918" />
    <SolidColorBrush x:Key="BrushTrack" Color="#FF2C3B45" />

    <SolidColorBrush x:Key="BrushWindowBg" Color="#FF101821" />
    <SolidColorBrush x:Key="BrushNavSelected" Color="#FF203A3A" />
    <SolidColorBrush x:Key="BrushPrimaryButton" Color="#FF087F75" />
    <SolidColorBrush x:Key="BrushGlowAccent" Color="#FF53C6B5" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="1" Opacity="0.18" Color="#000000" />
    <DropShadowEffect x:Key="AccentShadow" BlurRadius="8" ShadowDepth="0" Opacity="0.18" Color="#53C6B5" />
    <DropShadowEffect x:Key="DangerShadow" BlurRadius="8" ShadowDepth="0" Opacity="0.18" Color="#F27B78" />

</ResourceDictionary>
