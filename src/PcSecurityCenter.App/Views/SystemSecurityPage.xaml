<UserControl x:Class="PcSecurityCenter.App.Views.SystemSecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="系统安全" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubTitle}"
                       Text="Defender · 防火墙 · 更新 · UAC · Secure Boot · TPM · BitLocker · 安全中心 · 账户 · RDP · SMBv1 —— 无法读取的项目会如实标注，绝不默认显示安全" />

            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="开始检查" Style="{StaticResource PrimaryButton}" Command="{Binding RunChecksCommand}"
                                IsEnabled="{Binding !IsChecking}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Grade}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border Style="{StaticResource StatusPill}" ToolTip="{Binding ElevationHint}">
                            <TextBlock Text="权限说明" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0" Background="{DynamicResource BrushStatusPillBg}">
                                            <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Result}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0">
                                        <Run Text="检测方式：" Foreground="{DynamicResource BrushTextMuted}" /><Run Text="{Binding Method, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding RiskExplanation}" FontSize="11" Foreground="{DynamicResource BrushWarn}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding RiskExplanation, Converter={StaticResource NotEmptyToVisible}}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource BrushOk}" TextWrapping="Wrap" Margin="0,3,0,0">
                                        <Run Text="建议：" Foreground="{DynamicResource BrushTextMuted}" /><Run Text="{Binding Recommendation, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Top" Margin="10,0,0,0">
                                    <TextBlock FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Status}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushOk}" />
                                                        <Setter Property="Text" Value="✓ 通过" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushWarn}" />
                                                        <Setter Property="Text" Value="△ 注意" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Risk">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                                        <Setter Property="Text" Value="✕ 风险" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushWarn}" />
                                                        <Setter Property="Text" Value="! 检查失败" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="NotSupported">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                                        <Setter Property="Text" Value="— 暂不支持" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="NoPermission">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                                        <Setter Property="Text" Value="🔒 权限不足" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
