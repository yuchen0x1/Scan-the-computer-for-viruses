<UserControl x:Class="PcSecurityCenter.App.Views.SoftwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="软件管理" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubTitle}"
                       Text="已安装软件只读枚举（卸载注册表）· 数字签名检查 · 卸载入口为官方向导（非静默卸载）" />

            <Border Style="{StaticResource SectionCard}">
                <DockPanel>
                    <Button Content="↻ 枚举已安装软件" Style="{StaticResource PrimaryButton}" Command="{Binding LoadAppsCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <DataGrid ItemsSource="{Binding Apps}" MinHeight="400" MaxHeight="620" RowHeight="32"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="软件名称" Binding="{Binding DisplayName}" Width="125" MinWidth="110" />
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="60" />
                        <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="90" />
                        <DataGridTextColumn Header="安装日期" Binding="{Binding InstallDate}" Width="68" />
                        <DataGridTextColumn Header="安装位置" Binding="{Binding InstallLocation}" Width="*" MinWidth="100" />
                        <DataGridTemplateColumn Header="签名" Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushOk}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                        <Setter Property="Text" Value="✕" />
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushWarn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="风险提示" Binding="{Binding RiskNote}" Width="90" />
                        <DataGridTemplateColumn Header="操作" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="卸载" Style="{StaticResource SmallGhostButton}" Padding="6,4" Margin="1,0"
                                            Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
