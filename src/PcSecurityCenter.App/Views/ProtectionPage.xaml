<UserControl x:Class="PcSecurityCenter.App.Views.ProtectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="实时防护" Style="{StaticResource PageTitle}" />
            <TextBlock Text="事件驱动 + 低频轮询监控：启动目录（FileSystemWatcher）、注册表启动项、新增进程、Defender 状态"
                       Style="{StaticResource PageSubTitle}" />

            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="实时防护：" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="{Binding IsRunning, StringFormat=逆变器}" Visibility="Collapsed" />
                            <TextBlock FontSize="14" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="已停止" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="运行中" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushOk}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding DefenderRtText}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" MaxWidth="640"
                                   Text="监控内容：启动文件夹新文件（内容规则分析）· Run 键增删改 · 临时目录新进程 · Defender 实时防护开关变化" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ApplyIntervalCommand}" Style="{StaticResource GhostButton}"
                                Content="{Binding PollIntervalSec, StringFormat=轮询 {0}s ↻}" Margin="0,0,8,0" />
                        <Button Command="{Binding ToggleProtectionCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9">
                            <TextBlock FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="开启防护" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="停止防护" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="防护事件（最新在前，落库保存）" FontWeight="Bold" />
                        <Button Content="清空显示" Style="{StaticResource SmallGhostButton}" DockPanel.Dock="Right"
                                Command="{Binding ClearEventsCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushCardSoft}" CornerRadius="8" Padding="10,7" Margin="0,3">
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat=MM-dd HH:mm:ss}" Foreground="{DynamicResource BrushTextMuted}" />
                                            <Run Text=" [" /><Run Text="{Binding Severity, Mode=OneWay}" /><Run Text="] " />
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
