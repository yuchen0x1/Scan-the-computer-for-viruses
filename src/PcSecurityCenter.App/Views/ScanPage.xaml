<UserControl x:Class="PcSecurityCenter.App.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:PcSecurityCenter.App.Services">
    <UserControl.Resources>
        <services:ThreatLabelConverter x:Key="ThreatLabel" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="病毒查杀" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubTitle}"
                       Text="真实引擎扫描：Microsoft Defender 官方接口（PowerShell/MpCmdRun）+ SmartRisk 智能风险规则引擎" />

            <!-- 引擎状态 -->
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding EngineText}" TextWrapping="Wrap" FontSize="12.5" />
                        <TextBlock Text="{Binding SignatureText}" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="刷新状态" Style="{StaticResource SmallGhostButton}" Margin="0,0,8,0"
                                Command="{Binding RefreshDefenderCommand}" />
                        <Button Content="更新病毒库" Style="{StaticResource SmallGhostButton}"
                                Command="{Binding UpdateSignaturesCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 扫描入口：快速 + 全盘（两列），自定义扫描独占一行 -->
            <UniformGrid Columns="2" Margin="0,0,0,9">
                <Border Style="{StaticResource SectionCard}" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="⚡ 快速扫描" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="Defender 原生快速扫描（内存+启动区）+ 启动目录/临时/下载目录智能风险检查。约 1-5 分钟。"
                                   FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <Button Content="开始快速扫描" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                Command="{Binding StartQuickCommand}" IsEnabled="{Binding CanStartScan}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}" Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🗂 全盘扫描" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="所有固定磁盘逐目录交给 Defender 引擎扫描。支持暂停 / 继续 / 取消，显示真实进度与速度。耗时较长。"
                                   FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <Button Content="开始全盘扫描" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                Command="{Binding StartFullCommand}" IsEnabled="{Binding CanStartScan}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="🎯 自定义扫描" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="选择要扫描的文件或文件夹；未添加路径时会提示先添加。"
                                   FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="＋ 文件夹" Style="{StaticResource SmallGhostButton}" Margin="0,0,6,0"
                                Command="{Binding AddFolderCommand}" />
                        <Button Content="＋ 文件" Style="{StaticResource SmallGhostButton}" Margin="0,0,6,0"
                                Command="{Binding AddFileCommand}" />
                        <Button Content="开始自定义扫描" Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartCustomCommand}" IsEnabled="{Binding CanStartScan}" />
                    </StackPanel>
                </Grid>
                <!-- 已选路径：用 WrapPanel 让标签在窄窗口自动换行，而不是被窗口边缘硬切 -->
                <ItemsControl ItemsSource="{Binding CustomPaths}" Margin="0,10,0,0" MaxHeight="78">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MaxWidth="420" CornerRadius="5" Padding="6,2" Margin="0,1,6,1"
                                    Background="{DynamicResource BrushCardSoft}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="✕" Cursor="Hand" Margin="6,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource BrushTextMuted}" FontSize="10"
                                            Command="{Binding DataContext.RemovePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 扫描进度 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource BrushAccentMedium}">
                                <TextBlock Text="{Binding ScanStateText}" FontSize="12" Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding ScanMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="⏸ 暂停" Style="{StaticResource SmallGhostButton}" Command="{Binding PauseCommand}"
                                    Margin="0,0,6,0" IsEnabled="{Binding IsScanning}" />
                            <Button Content="▶ 继续" Style="{StaticResource SmallGhostButton}" Command="{Binding ResumeCommand}"
                                    Margin="0,0,6,0" />
                            <Button Content="✕ 取消" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}"
                                    IsEnabled="{Binding IsScanning}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding IsEstimating}" Maximum="100" Style="{StaticResource AccentProgress}" Height="10" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center">
                            <Run Text="{Binding FilesScanned, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding FilesTotal, Mode=OneWay}" />
                            <Run Text=" 个已枚举文件（不等于 Defender 检测量）" />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding SpeedText}" FontSize="11.5" Foreground="{DynamicResource BrushAccent}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding ElapsedText}" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CoverageWarnings}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,0" AutomationProperties.Name="扫描覆盖限制" />
                    <TextBlock Text="{Binding CurrentItem}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 威胁列表（列宽合计 &lt; 内容区可用宽度，路径列占满剩余空间） -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="发现的威胁与风险" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="（Defender 检出 = 确认威胁；SmartRisk 检出 = 可疑风险，需人工判断）" FontSize="11"
                                   Foreground="{DynamicResource BrushTextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <CheckBox Content="仅确认威胁" IsChecked="{Binding ConfirmedOnly}" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="搜索" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ThreatSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="搜索威胁名称、路径、引擎或依据" ToolTip="搜索名称、路径、引擎或检测依据" />
                    </DockPanel>
                    <TextBlock Text="{Binding ThreatCountText}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding ThreatsView}" MinHeight="120" MaxHeight="280"
                              EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" />
                            <DataGridTextColumn Header="级别" Binding="{Binding Severity, Converter={StaticResource ThreatLabel}}" Width="54" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind, Converter={StaticResource ThreatLabel}}" Width="76" />
                            <DataGridTextColumn Header="路径" Binding="{Binding FilePath}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="引擎" Binding="{Binding Engine, Converter={StaticResource ThreatLabel}}" Width="72" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status, Converter={StaticResource ThreatLabel}}" Width="58" />
                            <DataGridTemplateColumn Header="操作" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="1,0">
                                            <Button Content="隔离" ToolTip="本地规则项可加密隔离；Defender 记录请在 Windows 安全中心处理" Style="{StaticResource ThreatActionButton}" Margin="0,0,2,0"
                                                    Command="{Binding DataContext.QuarantineThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    IsEnabled="{Binding DataContext.CanStartScan, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource ThreatActionButton}" Margin="0,0,2,0"
                                                    Command="{Binding DataContext.DeleteThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    IsEnabled="{Binding DataContext.CanStartScan, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="忽略" Style="{StaticResource ThreatActionButton}" Margin="0,0,2,0"
                                                    Command="{Binding DataContext.AllowThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    IsEnabled="{Binding DataContext.CanStartScan, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="详情" Style="{StaticResource ThreatActionButton}"
                                                    Command="{Binding DataContext.ShowThreatDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 隔离区 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="隔离区（AES-256 加密仓库 · SHA256 完整性校验）" FontWeight="Bold" />
                        <Button Content="打开隔离库目录" Style="{StaticResource SmallGhostButton}" DockPanel.Dock="Right"
                                Command="{Binding OpenVaultLocationCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding QuarantineEntries}" MinHeight="80" MaxHeight="200"
                              EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="150" />
                            <DataGridTextColumn Header="原始位置" Binding="{Binding OriginalPath}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="隔离时间" Binding="{Binding QuarantinedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="120" />
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="150" />
                            <DataGridTemplateColumn Header="操作" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,0">
                                            <Button Content="恢复" Style="{StaticResource SmallGhostButton}" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.RestoreQuarantinedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="彻底删除" Style="{StaticResource SmallGhostButton}"
                                                    Command="{Binding DataContext.DeleteQuarantinedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
