<UserControl x:Class="PcSecurityCenter.App.Views.MaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="系统维护" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubTitle}"
                       Text="先扫描后清理 · 白名单目录 · 跳过使用中文件 · SFC/DISM/chkdsk 只读检查（提权需确认）" />

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="扫描可清理项" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"
                                Command="{Binding ScanCleanableCommand}" IsEnabled="{Binding !IsBusy}" />
                        <Button Content="执行清理" Style="{StaticResource DangerButton}" Margin="0,0,8,6"
                                Command="{Binding CleanCommand}" IsEnabled="{Binding !IsBusy}" />
                        <Button Content="分析磁盘空间" Style="{StaticResource GhostButton}" Margin="0,0,0,6"
                                Command="{Binding AnalyzeDiskCommand}" IsEnabled="{Binding !IsBusy}" />
                    </WrapPanel>
                    <DockPanel Margin="0,4,0,0" LastChildFill="True">
                        <Border Style="{StaticResource StatusPill}" DockPanel.Dock="Right" Margin="10,0,0,0"
                                Background="{DynamicResource BrushAccentMedium}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold">
                                <Run Text="已选释放：" /><Run Text="{Binding SelectedBytes, Mode=OneWay, StringFormat={}{0:N0} B}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="可清理项（先扫描后展示；勾选后清理）" FontWeight="Bold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding CleanItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,7" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center"
                                                  Checked="ItemChecked" Unchecked="ItemChecked" />
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" ToolTip="需要管理员权限才能清理">
                                                    <TextBlock Text="需管理员" FontSize="10" Foreground="{DynamicResource BrushWarn}"
                                                               Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Right">
                                                <Run Text="{Binding SizeBytesHuman, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right">
                                                <Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text=" 个文件" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,9,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="系统文件检查 (SFC)" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="运行只读检查" Style="{StaticResource SmallGhostButton}" Margin="10,0,0,0"
                                    Command="{Binding RunSfcCommand}" IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                        <TextBox Text="{Binding SfcOutput, Mode=OneWay}" IsReadOnly="True" MinHeight="70" MaxHeight="180"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="磁盘错误检查 (chkdsk 只读)" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="运行检查" Style="{StaticResource SmallGhostButton}" Margin="10,0,0,0"
                                    Command="{Binding RunChkdskCommand}" IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                        <TextBox Text="{Binding ChkOutput, Mode=OneWay}" IsReadOnly="True" MinHeight="50" MaxHeight="150"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="9,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="DISM 系统映像检查" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="运行 ScanHealth" Style="{StaticResource SmallGhostButton}" Margin="10,0,0,0"
                                    Command="{Binding RunDismCommand}" IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                        <TextBox Text="{Binding DismOutput, Mode=OneWay}" IsReadOnly="True" MinHeight="70" MaxHeight="180"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="系统还原点" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="查看" Style="{StaticResource SmallGhostButton}" Margin="10,0,0,0" Command="{Binding LoadRestorePointsCommand}" />
                            <Button Content="创建还原点" Style="{StaticResource SmallGhostButton}" Margin="6,0,0,0" Command="{Binding CreateRestorePointCommand}" IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RestorePointsText}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,6,0,0" />
                        <ItemsControl ItemsSource="{Binding RestorePoints}" MaxHeight="120">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" Margin="0,2" TextWrapping="Wrap">
                                        <Run Text="{Binding CreationTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}" Foreground="{DynamicResource BrushTextMuted}" />
                                        <Run Text=" " /><Run Text="{Binding Description, Mode=OneWay, StringFormat={}{0}}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
