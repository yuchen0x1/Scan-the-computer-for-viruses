<UserControl x:Class="PcSecurityCenter.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="启动项管理" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubTitle}"
                       Text="注册表 Run/RunOnce · 启动文件夹 · 风险标注。禁用采用改名方式（可恢复），不删除数据；HKLM 项需管理员权限" />

            <Border Style="{StaticResource SectionCard}">
                <DockPanel>
                    <Button Content="↻ 重新枚举" Style="{StaticResource PrimaryButton}" Command="{Binding LoadStartupCommand}" IsEnabled="{Binding !IsBusy}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <DataGrid ItemsSource="{Binding StartupItems}" MinHeight="300" MaxHeight="520"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110" />
                        <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="*" MinWidth="100" />
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="78" />
                        <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="90" />
                        <DataGridTemplateColumn Header="签名" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushOk}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                        <Setter Property="Text" Value="✕" />
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushWarn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="状态" Binding="{Binding EnabledText}" Width="52" />
                        <DataGridTextColumn Header="风险" Binding="{Binding RiskText}" Width="110" />
                        <DataGridTemplateColumn Header="操作" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ToggleText}" Style="{StaticResource SmallGhostButton}" Padding="6,4" Margin="1,0"
                                            Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
