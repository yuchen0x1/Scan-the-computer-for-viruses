<UserControl x:Class="PcSecurityCenter.App.Views.ReportCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="安全报告中心" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubTitle}"
                       Text="汇总扫描 / 检查 / 威胁处理 / 维护 / 事件记录，导出 HTML 或 PDF（报告内如实标注覆盖范围与限制）" />

            <Border Style="{StaticResource SectionCard}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导出 HTML 报告" Style="{StaticResource PrimaryButton}" Command="{Binding ExportHtmlCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="导出 PDF 报告" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding ExportPdfCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="打开报告目录" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding OpenReportsDirCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="扫描历史" FontWeight="Bold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Scans}" MaxHeight="260" FontSize="11.5" RowHeight="28"
                                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding StartedAt, StringFormat=MM-dd HH:mm}" Width="76" />
                                <DataGridTextColumn Header="结果" Binding="{Binding FinalState}" Width="60" />
                                <DataGridTextColumn Header="文件数" Binding="{Binding FilesScanned}" Width="54" />
                                <DataGridTextColumn Header="风险" Binding="{Binding ThreatsFound}" Width="42" />
                                <DataGridTextColumn Header="引擎" Binding="{Binding Engines}" Width="*" MinWidth="56" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="维护记录" FontWeight="Bold" Margin="0,14,0,8" />
                        <DataGrid ItemsSource="{Binding MaintenanceRuns}" MaxHeight="200" FontSize="11.5" RowHeight="28"
                                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding StartedAt, StringFormat=MM-dd HH:mm}" Width="84" />
                                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="*" MinWidth="80" />
                                <DataGridTextColumn Header="释放" Binding="{Binding FreedBytesHuman}" Width="72" />
                                <DataGridTextColumn Header="结果" Binding="{Binding SuccessText}" Width="52" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Text="安全事件记录" FontWeight="Bold" Margin="0,0,0,8" />
                        <!-- 不使用内层 ScrollViewer：避免与外层页面滚动互相抢滚轮。
                             事件列表直接放在卡片中，高度由外层页面管理。 -->
                        <ItemsControl ItemsSource="{Binding Events}" MaxHeight="500">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushCardSoft}" CornerRadius="7" Padding="9,6" Margin="0,3">
                                            <StackPanel>
                                                <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                                    <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat=MM-dd HH:mm:ss}" Foreground="{DynamicResource BrushTextMuted}" />
                                                    <Run Text=" [" /><Run Text="{Binding Severity, Mode=OneWay}" /><Run Text="] " />
                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
